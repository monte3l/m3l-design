{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "signoff": "monte3l-release[bot] <333264726+monte3l-release[bot]@users.noreply.github.com>",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "refactor", "section": "Changed" },
    { "type": "fix", "section": "Fixed" }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "exclude-paths": [".claude", ".github", ".groundwork", "artifact", "avatars", "bin", "design", "docs", "LICENSES", "scripts", "test"],
      "extra-files": [
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "design/README.md" }
      ]
    }
  }
}
