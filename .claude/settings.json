{
  "enabledPlugins": {
    "context7@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": true
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated.sh" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/release-guard.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-after-edit.sh" }] }
    ]
  }
}
